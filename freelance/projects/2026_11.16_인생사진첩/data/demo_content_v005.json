{
  "demo_only": true,
  "note": "사용자 허용에 따른 가상 성함·원고·AI 생성 사진. 고객 실제 기록 아님.",
  "authors": [
    {
      "id": "A01",
      "name": "김정숙",
      "bio": "익숙한 동네를 천천히 걷습니다.\n무심코 지나쳤던 풍경에서\n새로운 이야기를 찾는 시간이 좋습니다.",
      "side_title": "익숙한\n하루를\n새롭게\n바라보다",
      "quote": "“늘 걷던 골목도,\n카메라로 바라보니\n새로웠습니다.”"
    },
    {
      "id": "A02",
      "name": "박영수",
      "bio": "산책하며 계절이 바뀌는 모습을 봅니다.\n작은 쉼과 고요한 순간을\n사진 한 장에 담아 두고 싶습니다.",
      "side_title": "잠시\n멈추어\n마음을\n쉬다",
      "quote": "“멈추어 바라보면\n작은 위로가\n보입니다.”"
    },
    {
      "id": "A03",
      "name": "이순자",
      "bio": "강과 바다를 바라보는 것을 좋아합니다.\n빛이 달라지는 순간을 기다리며\n하루의 표정을 기록합니다.",
      "side_title": "빛이\n머무는\n순간을\n담다",
      "quote": "“하루의 끝에도\n다음 출발의 빛이\n남아 있습니다.”"
    },
    {
      "id": "A04",
      "name": "최정호",
      "bio": "길을 걷다 잠시 멈추는 연습을 합니다.\n익숙한 장소도 새롭게 바라보면\n또 다른 이야기를 들려줍니다.",
      "side_title": "천천히\n걷는\n시간을\n만나다",
      "quote": "“기다리는 시간도\n한 장의 풍경이\n되었습니다.”"
    },
    {
      "id": "A05",
      "name": "정옥희",
      "bio": "오래된 담장과 초록빛을 좋아합니다.\n가까운 곳의 작은 변화를 찾아\n나만의 시선으로 남깁니다.",
      "side_title": "가까운\n풍경에\n마음을\n열다",
      "quote": "“가까운 곳에서\n나만의 이야기를\n찾았습니다.”"
    },
    {
      "id": "A06",
      "name": "강명자",
      "bio": "식물과 꽃을 돌보며 하루를 보냅니다.\n작은 생명이 자라는 순간을\n사진으로 함께 나누고 싶습니다.",
      "side_title": "작은\n생명의\n안부를\n묻다",
      "quote": "“작은 꽃 한 송이가\n하루를 환하게\n만들어 줍니다.”"
    },
    {
      "id": "A07",
      "name": "윤상철",
      "bio": "집 안의 조용한 풍경을 살펴봅니다.\n빛과 온기가 머무는 자리에서\n소박한 행복을 발견합니다.",
      "side_title": "평범한\n오후의\n온기를\n담다",
      "quote": "“평범한 오후에도\n오래 남는 온기가\n있습니다.”"
    },
    {
      "id": "A08",
      "name": "장미숙",
      "bio": "날씨가 달라질 때마다 길을 나섭니다.\n비 오는 날과 맑은 날의 표정을\n천천히 비교하며 사진을 찍습니다.",
      "side_title": "달라진\n날씨의\n표정을\n찾다",
      "quote": "“날씨가 달라지면\n마음의 풍경도\n달라집니다.”"
    },
    {
      "id": "A09",
      "name": "한정희",
      "bio": "자연 속에서 작은 움직임을 찾습니다.\n기다리는 시간을 즐기며\n순간의 빛을 담는 법을 배웁니다.",
      "side_title": "조용한\n순간의\n빛을\n기다리다",
      "quote": "“조용히 기다리니\n작은 순간이\n다가왔습니다.”"
    },
    {
      "id": "A10",
      "name": "오영호",
      "bio": "나무와 꽃을 보며 마음을 쉬어 갑니다.\n오래된 것과 새로 피는 것을\n다정한 시선으로 바라봅니다.",
      "side_title": "오늘의\n자연에\n마음을\n기대다",
      "quote": "“오늘도 자연에게\n천천히 살아가는\n법을 배웁니다.”"
    }
  ],
