        {
          "kind": "text",
          "x": 25,
          "y": 25,
          "w": 161,
          "h": 10,
          "text": "초록 길을 따라",
          "style": "RightTitle",
          "color": "accent_A05",
          "align": "left",
          "name": "RightWorkTitle"
        },
        {
          "kind": "text",
          "x": 25,
          "y": 39,
          "w": 161,
