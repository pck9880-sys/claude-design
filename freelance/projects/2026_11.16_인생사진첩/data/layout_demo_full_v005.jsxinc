          "name": "Running"
        },
        {
          "kind": "text",
          "x": 100,
          "y": 278,
          "w": 86,
          "h": 4,
          "text": "프레임에 담긴 나의 세상",
          "style": "Running",
          "color": "muted",
          "align": "right",
          "name": "Running"
        },
        {
          "kind": "text",
