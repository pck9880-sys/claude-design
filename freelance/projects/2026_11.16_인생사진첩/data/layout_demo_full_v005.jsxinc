          "x": 25,
          "y": 174,
          "w": 155,
          "h": 6,
          "text": "작품 01  /  담장에 그린 그림",
          "style": "Caption",
          "color": "muted",
          "align": "left",
          "name": "Caption"
        },
        {
          "kind": "block",
          "x": 25,
          "y": 190,
          "w": 32,
